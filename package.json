{
  "name": "angular-template",
  "version": "2.3.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:uat": "ng serve --configuration uat-local",
    "build": "node ./build/build-pre.js && ng build --configuration=production --aot --base-href /",
    "build-production": "node ./build/build-pre.js && ng build --configuration=production --aot --base-href /",
    "build-uat": "node ./build/build-pre.js && ng build --configuration=uat --aot --base-href /",
    "debug": "ng build --base-href /",
    "e2e": "playwright test",
    "e2e:auth": "playwright test --project=setup",
    "e2e:save-token": "node e2e/save-token.mjs",
    "e2e:cleanup": "node e2e/cleanup-residue.mjs",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:fast": "playwright test --grep @mocked",
    "e2e:affected": "node e2e/affected.mjs",
    "e2e:csp-probe-local": "node e2e/csp-probe-local.mjs",
    "lint": "ng lint",
    "fa:subset": "node build/fa-subset.mjs",
    "fa:check": "node build/check-fa-icons.mjs",
    "test:delivery-script": "node --test docs/poc_delivery_schedule_sync/Code.test.mjs"
  },
  "private": true,
  "main": "main.js",
  "overrides": {
    "@babel/core": "^7.29.7"
  },
  "dependencies": {
    "@angular/animations": "22.2.5",
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/localize": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@apollo/client": "^4.3.7",
    "@auth0/angular-jwt": "^5.2.0",
    "@auth0/auth0-angular": "^2.8.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@microsoft/applicationinsights-web": "^3.4.6",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@ng-select/ng-select": "^24.2.1",
    "@ngx-formly/bootstrap": "^11.1.0",
    "@ngx-formly/core": "^11.1.0",
    "@ngxs/devtools-plugin": "^22.0.0",
    "@ngxs/form-plugin": "^22.0.0",
    "@ngxs/router-plugin": "^22.0.0",
    "@ngxs/store": "^22.0.0",
    "@popperjs/core": "^2.11.8",
    "apollo-angular": "^14.2.0",
    "bootstrap": "^5.3.8",
    "core-js": "^3.49.0",
    "date-fns": "^4.1.0",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.11.0",
    "lodash": "^4.17.19",
    "ngx-lightbox": "^3.0.0",
    "ngx-progressbar": "^14.0.0",
    "ngx-toastr": "^20.0.5",
    "postcss": "^8.5.14",
    "prismjs": "^1.30.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@angular/language-service": "22.2.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "fontkit": "^2.0.4",
    "json-loader": "^0.5.7",
    "subset-font": "^2.9.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
