# ngx-toastr 20.0.5 is the latest published release and still declares
# @angular/{common,core} ^21.0.0 as peers, while this app is on Angular 22.
# It is a peer metadata lag, not a runtime incompatibility.
#
# This file is REQUIRED FOR CI, not just for local convenience. All three
# workflows (ci.yml, deploy-dev.yml, deploy-prod.yml) run `npm ci`, and
# `npm ci` DOES validate peer ranges - verified against node:24-bookworm-slim
# in Docker on 2026-09-22: ERESOLVE without this file, exit 0 with it.
# Deleting it breaks every build and deploy, not just local installs.
#
# Remove this file once ngx-toastr publishes a release peering on ^22.
legacy-peer-deps=true
