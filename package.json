{
  "name": "angular-template",
  "version": "1.2.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node ./build/build-pre.js && ng build --configuration=production --aot --base-href /",
    "build-production": "node ./build/build-pre.js && ng build --configuration=production --aot --base-href /",
    "build-uat": "node ./build/build-pre.js && ng build --configuration=uat --aot --base-href /",
    "debug": "ng build --base-href /",
    "server": "node server.js",
    "e2e": "playwright test",
    "e2e:auth": "playwright test --project=setup",
    "e2e:save-token": "node e2e/save-token.mjs",
    "e2e:cleanup": "node e2e/cleanup-residue.mjs",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:fast": "playwright test --grep @mocked",
    "lint": "ng lint"
  },
  "private": true,
  "main": "main.js",
  "overrides": {
    "@babel/core": "^7.29.7"
  },
  "dependencies": {
    "@angular/animations": "21.2.17",
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/localize": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "@angular/platform-browser-dynamic": "21.2.17",
    "@angular/router": "21.2.17",
    "@apollo/client": "^4.1.7",
    "@auth0/angular-jwt": "^5.2.0",
    "@auth0/auth0-angular": "^2.8.0",
    "@fortawesome/fontawesome-free": "^5.14.0",
    "@microsoft/applicationinsights-web": "^3.4.1",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@ng-select/ng-select": "^21.2.0",
    "@ngx-formly/bootstrap": "^7.1.0",
    "@ngx-formly/core": "^7.1.0",
    "@ngxs/devtools-plugin": "^21.0.0",
    "@ngxs/form-plugin": "^21.0.0",
    "@ngxs/router-plugin": "^21.0.0",
    "@ngxs/store": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "apollo-angular": "^13.0.0",
    "bootstrap": "^5.3.8",
    "core-js": "^3.49.0",
    "datatables.net": "^2.3.7",
    "datatables.net-bs5": "^2.3.7",
    "datatables.net-responsive": "^3.0.8",
    "datatables.net-rowreorder": "^1.5.1",
    "date-fns": "^4.1.0",
    "graphql": "^16.13.2",
    "graphql-tag": "^2.11.0",
    "jquery": "^3.5.1",
    "lodash": "^4.17.19",
    "ngx-lightbox": "^3.0.0",
    "ngx-progressbar": "^11.1.0",
    "ngx-quill": "^30.0.0",
    "ngx-toastr": "^20.0.5",
    "postcss": "^8.5.14",
    "prismjs": "^1.30.0",
    "quill": "^2.0.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular/build": "^21.2.18",
    "@angular/cli": "^21.2.18",
    "@angular/compiler-cli": "21.2.17",
    "@angular/language-service": "21.2.17",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/jquery": "^3.5.0",
    "@types/node": "^20.19.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.6.0",
    "json-loader": "^0.5.7",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.2"
  }
}
