# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist-server
/tmp
/out-tsc

# dependencies
/node_modules
/release
/dist

# Claude Code
.claude/settings.local.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
src/environments/version.ts

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.angular/cache
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# e2e
/e2e/*.js
/e2e/*.map
/e2e/.auth/
/playwright-report/
/test-results/

# System Files
.DS_Store
Thumbs.db
/.angular
# Local working notes and scratch artefacts (never part of the codebase).
# Root-level underscore-prefixed markdown is the session-handoff / feedback-round
# note convention; these are working memory, not documentation, and some quote
# real referee or client detail, so they must not be committable by `git add -A`.
/_*.md
# Local-only Playwright config for pointing the suite at production. Referenced by
# no script, workflow or doc - purely a convenience file, and one `git clean` from
# being lost, which is why it is ignored rather than left merely untracked.
playwright.config.prod.ts
